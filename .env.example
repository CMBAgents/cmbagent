# Copy to .env and fill in.

# --- Models -------------------------------------------------------------
GOOGLE_API_KEY=

# Required only for the self_debug *escalation* node (PlanContext.enable_escalation).
# Escalation runs a Claude Agent SDK agent — the one Anthropic dependency.
ANTHROPIC_API_KEY=

# --- Langfuse -----------------------------------------------------------
# Keys of your Langfuse project, and the URL of its server (Langfuse Cloud or a
# self-hosted instance) in both variables. See README.md § Langfuse.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
